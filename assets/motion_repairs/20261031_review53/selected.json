    "media": "raw:dataset_motion_2137",
    "category": "shoulders",
    "equipment": "dumbbell",
    "target": "delts",
    "muscle_group": "triceps",
    "secondary_muscles": [
      "triceps",
      "upper chest"
    ],
    "instructions_zh": [
      "坐在有背部支撑的长凳上，双手各握一个哑铃，与肩同高，手掌朝向身体，肘部弯曲。",
      "向上推哑铃，直到手臂完全伸展，手掌朝前。",
      "抬起时旋转手腕，使手掌在动作的最高点朝前。",
      "在最高点暂停片刻，然后慢慢将哑铃放回起始位置。",
      "重复所需的重复次数。"
    ]
  },
