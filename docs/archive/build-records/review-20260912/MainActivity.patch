+    /** Decode only the cover frame for lists; no running drawable and bounded memory. */
+    private boolean loadPackagedThumb(ImageView image, String value) {
+        try {
+            Bitmap bitmap = packagedThumbs.get(value);
+            if (bitmap == null) {
+                int id = packagedMediaResId(value);
+                if (id == 0) return false;
+                bitmap = ImageDecoder.decodeBitmap(ImageDecoder.createSource(getResources(), id),
+                        (decoder, info, source) -> {
+                            int width = info.getSize().getWidth(), height = info.getSize().getHeight();
+                            float scale = Math.min(1f, 240f / Math.max(width, height));
+                            decoder.setTargetSize(Math.max(1, Math.round(width * scale)), Math.max(1, Math.round(height * scale)));
+                        });
+                packagedThumbs.put(value, bitmap);
+            }
+            image.setImageBitmap(bitmap);
+            image.setContentDescription("静态封面，点开播放示范");
+            return true;
+        } catch (Exception ignored) { return false; }
+    }
